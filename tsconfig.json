  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "assets/js/fuzzy.js",
    "assets/js/dilution.js",
    "assets/js/temperature.js",
    "assets/js/checklists.js",
    "assets/js/chemical-meta.js",
    "assets/js/quizzes.js",
    "assets/js/version.js"
  ]
}
