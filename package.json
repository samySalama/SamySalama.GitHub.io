{
  "name": "steward-guide",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "دليل الاستيوارد — أدوات التطوير والاختبار فقط (التطبيق نفسه بلا بناء ولا اعتماديات)",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "serve": "python3 -m http.server 8000",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:unit",
    "fix:data": "node scripts/patch-data.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0"
  }
}
